# Normalise text to LF in the repository, and let git decide the working-tree
# ending per platform.
* text=auto

# Shell launchers and hooks must keep LF even when checked out on Windows --
# a CRLF shebang line makes the kernel look for an interpreter named
# "/bin/sh\r" and the script fails to exec.
*.sh text eol=lf
wk-plugin/workato-kit text eol=lf

# The Windows launcher is the mirror case: cmd.exe wants CRLF.
*.cmd text eol=crlf

# Generated by scripts/gen_lint_rules.py from docs/connectors/. Collapsed in
# diffs and excluded from language stats -- review the generator, not the 906
# files it emits.
skills/** linguist-generated=true
